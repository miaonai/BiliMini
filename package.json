{
  "name": "bilimini",
  "version": "2.4.2",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:ui": "node tests/popup.browser.js",
    "test:extension": "node tests/extension.browser.js",
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "release:check": "node scripts/check-release-version.cjs",
    "lint": "vue-cli-service lint",
    "build-watch": "vue-cli-service  --env.NODE_ENV=development build-watch --mode development"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "core-js": "^3.51.0",
    "element-ui": "^2.15.14",
    "keymaster": "^1.6.2",
    "vue": "^2.7.16"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.9",
    "@vue/cli-plugin-babel": "~5.0.9",
    "@vue/cli-plugin-eslint": "~5.0.9",
    "@vue/cli-service": "~5.0.9",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "playwright": "^1.64.1",
    "vue-cli-plugin-chrome-extension-cli": "~1.1.4",
    "vue-template-compiler": "^2.7.16"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true,
      "webextensions": true
