{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_desc__",
  "version": "2.4.1",
  "default_locale": "zh_CN",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "alarms",
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "*://*.bilibili.com/",
    "*://api.vc.bilibili.com/",
    "*://api.live.bilibili.com/"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BiliMini",
    "default_icon": {
      "19": "icons/19.png",
      "38": "icons/38.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+B"
      }
    }
  },
  "key": ""
}
